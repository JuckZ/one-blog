{
  "name": "one-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "node scripts/site-engine.mjs build",
    "build:next": "cross-env SITE_ENGINE=next node scripts/site-engine.mjs build",
    "build:quartz": "cross-env SITE_ENGINE=quartz node scripts/site-engine.mjs build",
    "content:prepare": "node scripts/prepare-published-content.mjs",
    "content:test": "node scripts/test-publication-pipeline.mjs",
    "content:verify": "node scripts/prepare-published-content.mjs --check",
    "dev": "node scripts/site-engine.mjs dev",
    "dev:next": "cross-env SITE_ENGINE=next node scripts/site-engine.mjs dev",
    "dev:quartz": "cross-env SITE_ENGINE=quartz node scripts/site-engine.mjs dev",
    "lint": "eslint src scripts tests next.config.mjs playwright.config.ts playwright.refine.config.ts",
    "pretest:e2e": "cross-env QUARTZ_BASE_URL=http://127.0.0.1:3100 NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3100 npm run build:quartz",
    "test": "npm run content:test",
    "test:e2e": "playwright test",
    "test:e2e:refine": "playwright test --config=playwright.refine.config.ts",
    "test:e2e:run": "playwright test",
    "refine": "refine",
    "start": "next start",
    "vercel:preview:prepare": "node scripts/prepare-anonymous-vercel-preview.mjs"
  },
