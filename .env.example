# Select either "quartz" or "next" without changing application code.
SITE_ENGINE=quartz

# Quartz production builds should always include both isolated locale projections.
QUARTZ_LOCALES=zh-CN,en-US

# Use the final public origin, including https:// and no trailing slash.
QUARTZ_BASE_URL=https://blog.example.com
NEXT_PUBLIC_SITE_URL=https://blog.example.com
